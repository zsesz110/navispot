# Spotify Configuration
# Only needed for authenticated Spotify features, not public playlist imports.
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3883/api/auth/callback

# Application URL
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3883

# For local development with public playlists longer than 99 tracks.
# Docker Compose sets this automatically.
# SPOTIFY_BROWSER_WORKER_URL=http://127.0.0.1:8787

# Navidrome Configuration (optional - can configure via UI)
# NAVIDROME_URL=http://localhost:4533
# NAVIDROME_USERNAME=
# NAVIDROME_PASSWORD=
